# Copy to .env for `docker compose`. All optional — sensible defaults apply.
EA_TOKEN=changeme
# AI Review / auto-tag settings.
# AI_PROVIDER can be 'ollama' or 'anthropic' (defaults to 'ollama' if ANTHROPIC_API_KEY is not set)
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
AI_MODEL=qwen3.5:9b
AI_MODEL_FALLBACK=qwen3.5:9b

# For Anthropic Claude (cloud)
ANTHROPIC_API_KEY=

