# Normalize line endings: store text as LF in the repo regardless of the
# committer's OS. Stops the Windows CRLF churn that inflated earlier diffs.
* text=auto eol=lf

# Explicit text types (belt-and-suspenders for the common source files).
*.js    text eol=lf
*.jsx   text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.json  text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.md    text eol=lf
*.mq5   text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf

# Binary assets — never touch.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.db     binary
*.sqlite binary
